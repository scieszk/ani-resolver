# Optional for public Bangumi reads; useful for authenticated API behavior.
BANGUMI_ACCESS_TOKEN=

# Required for TMDB work search and details.
TMDB_ACCESS_TOKEN=
# Alternatively, use a TMDB v3 API key.
TMDB_API_KEY=

# Optional for networks that require an HTTP proxy. Node 24 reads these at startup.
NODE_USE_ENV_PROXY=1
HTTPS_PROXY=
