# Optional for public Bangumi reads; useful for authenticated API behavior.
BANGUMI_ACCESS_TOKEN=

# Required for TMDB work search and details.
TMDB_ACCESS_TOKEN=
# Alternatively, use a TMDB v3 API key.
TMDB_API_KEY=

# Required for SauceNAO reverse-image lookup.
SAUCENAO_API_KEY=

# Optional trace.moe API key for a higher request limit.
TRACE_MOE_API_KEY=

# Optional for networks that require an HTTP proxy. Node 24 reads these at startup.
NODE_USE_ENV_PROXY=1
HTTPS_PROXY=

# Optional storage locations. Defaults to ~/.ani-resolver and its web subdirectory.
ANI_RESOLVER_HOME=
ANI_RESOLVER_WEB_DATA=
