{
  "name": "ani-resolver",
  "version": "0.1.0",
  "description": "Provider-based anime metadata resolution infrastructure.",
  "keywords": [
    "anime",
    "bangumi",
    "tmdb",
    "resolver",
    "metadata",
    "provider",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scieszk/ani-resolver.git"
  },
  "homepage": "https://github.com/scieszk/ani-resolver#readme",
  "bugs": {
    "url": "https://github.com/scieszk/ani-resolver/issues"
  },
  "type": "module",
  "bin": {
    "ani-resolver": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "start:web": "node dist/bin.js web",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@napi-rs/keyring": "1.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "commander": "^15.0.0",
    "cordis": "4.0.0-rc.8",
    "fastify": "^5.12.1",
    "lucide-react": "^1.37.0",
    "parse-torrent": "^11.0.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@types/parse-torrent": "^11.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^5.1.4",
    "fflate": "0.8.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
